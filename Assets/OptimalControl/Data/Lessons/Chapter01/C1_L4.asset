  id: C1.L4
  schemaVersion: 1
  contentVersion: '1'
  title: Riferimento desiderato e rollout manuale
  description: 'Produzione F13: costi e vincoli I pp.14–23; riferimento e rollout I pp.24–25,35.'
  objective: Riferimento desiderato e rollout manuale
  prerequisiteLessonIds:
  - C1.L3
  workspace:
    assetPath: Assets/OptimalControl/Scenes/LessonWorkspace.unity
  experiment: {fileID: 11400000, guid: 80f001a129875cc9b47d4c10e8a69f69, type: 2}
  formulas:
  - {fileID: 11400000, guid: bd943400bc0d5de9bfd5c6d6740cc0d8, type: 2}
