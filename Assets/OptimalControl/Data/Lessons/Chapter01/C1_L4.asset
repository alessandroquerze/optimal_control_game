    - StateTime
    - trajectory
    - input
    - next
    - cost
    - desired
    - target
    showCosts: 1
    entryActions:
    - kind: 5
      index: 0
      target: ''
      value: 0
      vector: []
      scope: 0
    - kind: 6
      index: 0
      target: ''
      value: 0
      vector:
      - 1
      scope: 1
    - kind: 4
      index: 10
      target: ''
      value: 0
      vector: []
      scope: 0
    question: Quale affermazione è corretta?
    answers:
    - id: same-sample
      text: Stage e scarto confrontano reale e desiderato allo stesso t.
      feedback: 'Corretto: confronta formula, valori e vista.'
    - id: wrong
      text: Ogni stage usa sempre il riferimento iniziale t=0.
      feedback: Rileggi la relazione mostrata e distingui criterio, riferimento, ammissibilità e rollout.
    conditions:
    - evaluatorId: term
      targetId: error
      expectedAnswerId: ''
    - evaluatorId: term
      targetId: state-part
      expectedAnswerId: ''
    - evaluatorId: answer
      targetId: ''
      expectedAnswerId: same-sample
  - id: change-reference
    title: Stesso controllo, desiderio diverso
    objective: Confrontare revisioni con riferimento proprio.
    instruction: 'La configurazione A è salvata a t=10 con u=1. Prima prevedi dalla formula: x_t resta fisso, ma
      cambiare x_des cambia e_t e il contributo di tracking. In costo/limiti modifica cost.reference.state.10.0
      da .5 a .8. Si cambia SOLO quel campione desiderato; il nuovo punto non promette equilibrio. B ha costo/reference
      propri; A conserva i suoi. Non è una ricerca dell’ottimo.'
    help: Formula e valori appartengono alla stessa revisione del rollout. Reset/Ricomincia torna al primo step;
      Indietro ripristina autonomamente questa attività.
    formulaFocus: {fileID: 11400000, guid: e1fec4511040575482af94d280499cf1, type: 2}
    selectedTermId: reference.state
    visibleTermIds:
    - reference.state
    - state.current
    - error
    - state-part
    - stage
    enabledControlIds:
    - parameter
    - comparison
    - seek
    editableParameterTargets:
    - cost.reference.state.10.0
    visibleLayerIds:
    - PhysicalBody
    - PhasePlane
    - StateTime
    - trajectory
    - input
    - next
    - cost
    - desired
    - target
    - comparison
    showCosts: 1
    entryActions:
    - kind: 5
      index: 0
      target: ''
      value: 0
