      value: 0
      vector: []
      scope: 0
    question: Quale affermazione è corretta?
    answers:
    - id: wrong
      text: Il riferimento nuovo riscrive retroattivamente anche il risultato A.
      feedback: Rileggi la relazione mostrata e distingui criterio, riferimento, ammissibilità e rollout.
    - id: reference
      text: Cambia riferimento e costo di B; rollout e configurazione A restano propri.
      feedback: 'Corretto: confronta formula, valori e vista.'
    conditions:
    - evaluatorId: action
      targetId: parameter.changed:cost.reference.state.10.0
      expectedAnswerId: ''
    - evaluatorId: term
