  m_Name: C1_L6
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.LessonDefinition
  id: C1.L6
  schemaVersion: 1
  contentVersion: '1'
  title: Continuo e trasferimento del pendolo
  description: F15; I pp.31–36. Problema continuo, Euler, quadratura distinta e confronto a durata comune; nessun
    solver.
  objective: Distinguere t/τ/δ/N/H, densità/cella/cumulativo/terminale; campionare reference tra equilibri e confrontare
    griglie dello stesso problema fisico.
  prerequisiteLessonIds:
  - C1.L5
  workspace:
    assetPath: Assets/OptimalControl/Scenes/LessonWorkspace.unity
  experiment: {fileID: 11400000, guid: e0d63f9c3c9e55c2afd9d041fe17d4d6, type: 2}
  formulas:
  - {fileID: 11400000, guid: e591980bd294585380f61073185dcc86, type: 2}
  - {fileID: 11400000, guid: f60f663dbb2b550daed42bd0fb9a4b95, type: 2}
  - {fileID: 11400000, guid: 2d13dfde83ea57c5bf84e4d83d63436e, type: 2}
