  m_Script: {fileID: 11500000, guid: 2447a3f1440a48128f99dcbb8f745af5, type: 3}
  m_Name: C1_L2
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.LessonDefinition
  id: C1.L2
  schemaVersion: 1
  contentVersion: '2'
  title: Traiettorie, equilibri e linearizzazione
  description: 'C1.L2 di produzione: I pp.10–13; pendolo/Euler già introdotti da C1.L1. Non è il prototipo.'
  objective: Riconoscere traiettorie ed equilibri; linearizzare sulla nominale e verificare limiti ed errore
    dell’approssimazione.
  prerequisiteLessonIds:
  - C1.L1
  workspace:
    assetPath: Assets/OptimalControl/Scenes/LessonWorkspace.unity
  experiment: {fileID: 11400000, guid: fff54ef3b56e5be9a7ba469c36d52fc2, type: 2}
  formulas:
  - {fileID: 11400000, guid: c1b3cde9150a5f56a67bd4f2e01aca53, type: 2}
