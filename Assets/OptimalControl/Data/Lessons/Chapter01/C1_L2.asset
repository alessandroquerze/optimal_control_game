    - kind: 5
      index: 0
      target: ''
      value: 0
      vector: []
      scope: 0
    - kind: 8
      index: 0
      target: ''
      value: 0
      vector:
      - 0
      - 0
      scope: 0
    - kind: 12
      index: 0
      target: ''
