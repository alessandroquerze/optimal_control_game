    - next
    - linearization
    - linearization-error
    showCosts: 0
    entryActions:
    - kind: 5
      index: 0
      target: ''
      value: 0
      vector: []
      scope: 0
    - kind: 8
      index: 0
      target: ''
      value: 0
      vector:
      - 0
      - 0
      scope: 0
    - kind: 12
      index: 0
      target: ''
      value: 0
      vector: []
      scope: 0
    question: Questo esperimento conserva l’ipotesi Δx₀=0?
    answers:
    - id: fixed
      text: Sì, Δx₀ è sempre zero per definizione.
      feedback: È zero soltanto nel caso iniziale fissato; qui lo abbiamo cambiato.
    - id: separate
      text: 'No: abbiamo perturbato esplicitamente la condizione iniziale.'
      feedback: Esatto. Non si confonde un parametro iniziale modificato con una decisione libera di ottimizzazione.
    conditions:
    - evaluatorId: linearization.available
      targetId: ''
      expectedAnswerId: ''
    - evaluatorId: action
      targetId: initial.changed
      expectedAnswerId: ''
    - evaluatorId: action
      targetId: time.advanced
      expectedAnswerId: ''
    - evaluatorId: linearization.initial-perturbed
      targetId: ''
      expectedAnswerId: ''
    - evaluatorId: linearization.error-nonzero
      targetId: ''
      expectedAnswerId: ''
    - evaluatorId: term
      targetId: error
      expectedAnswerId: ''
    - evaluatorId: answer
      targetId: ''
      expectedAnswerId: separate
  - id: amplitude
    title: Quanto lontano vale l’approssimazione?
    objective: Confrontare piccola e grande perturbazione sulla stessa nominale.
    instruction: 'Rimani a t=1. Prima leggi e_ω per Δθ₀=0.1: circa 0.00003268365 rad/s. Aumenta Δx₀[0], per esempio a 0.8
      rad: il nuovo errore è e_ω≈0.01621473497 rad/s. La nominale e i Jacobiani restano identici; cresce la
      distanza dalla nominale. La freccia rossa è ingrandita ×20 solo nel grafico, i valori HUD non sono scalati.'
    help: ''
    formulaFocus: {fileID: 11400000, guid: bf1d7393a5cd521589011cd0f72eda9c, type: 2}
    selectedTermId: delta.initial
    visibleTermIds:
    - delta.initial
