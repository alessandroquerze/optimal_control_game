    editableParameterTargets:
    - cost.r.0
    visibleLayerIds:
    - PhysicalBody
    - PhasePlane
    - StateTime
    - trajectory
    - input
    - next
    - cost
    showCosts: 1
    entryActions:
    - kind: 5
      index: 0
      target: ''
      value: 0
      vector: []
      scope: 0
    question: Quale affermazione è corretta?
    answers:
    - id: weight
      text: R pesa lo scarto del controllo, non lo vieta.
      feedback: 'Corretto: confronta formula, valori e vista.'
    - id: wrong
      text: R è un limite massimo duro dell’attuatore.
      feedback: Rileggi la relazione mostrata e distingui criterio, riferimento, ammissibilità e rollout.
    conditions:
    - evaluatorId: action
      targetId: parameter.changed:cost.r.0
      expectedAnswerId: ''
    - evaluatorId: answer
      targetId: ''
      expectedAnswerId: weight
  - id: terminal-weight
    title: Valutare anche l’esito finale
    objective: Leggere reference e peso al terminale.
    instruction: 'Seleziona ℓ_T e x_T^des. Q_T pesa lo scarto FINALE, non una transizione aggiuntiva. Prevedi: aumentare
      Q_T[0] da 5 a 10 aumenta l’addendo finale se lo scarto è non nullo. Modifica il peso; il diamante mostra ℓ_T.
      Non esiste u_T.'
    help: Formula e valori appartengono alla stessa revisione del rollout. Reset/Ricomincia torna al primo step;
      Indietro ripristina autonomamente questa attività.
    formulaFocus: {fileID: 11400000, guid: 36de24aa5ea056489becb88c1a897338, type: 2}
