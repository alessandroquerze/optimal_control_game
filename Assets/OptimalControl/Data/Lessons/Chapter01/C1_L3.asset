      index: 0
      target: ''
      value: 0
      vector: []
      scope: 0
    question: Quale affermazione è corretta?
    answers:
    - id: hard
      text: g>0 segnala una violazione; il controllo non viene saturato.
      feedback: 'Corretto: confronta formula, valori e vista.'
    - id: wrong
      text: Il limite viene automaticamente convertito in peso R.
      feedback: Rileggi la relazione mostrata e distingui criterio, riferimento, ammissibilità e rollout.
    conditions:
