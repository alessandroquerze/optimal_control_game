    - feasible
    enabledControlIds: []
    editableParameterTargets: []
    visibleLayerIds:
    - PhysicalBody
    - PhasePlane
    - StateTime
    - trajectory
    - input
    - next
    - cost
    - constraints
    showCosts: 1
    entryActions:
    - kind: 5
      index: 0
      target: ''
      value: 0
      vector: []
      scope: 0
    question: Quale affermazione è corretta?
    answers:
    - id: wrong
      text: h=0 garantisce automaticamente qualunque vincolo r.
      feedback: Rileggi la relazione mostrata e distingui criterio, riferimento, ammissibilità e rollout.
    - id: endpoint
      text: Un rollout valido può violare un vincolo end-point.
      feedback: 'Corretto: confronta formula, valori e vista.'
