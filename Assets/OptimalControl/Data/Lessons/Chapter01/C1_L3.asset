  id: C1.L3
  schemaVersion: 1
  contentVersion: '2'
  title: Costi, prestazione e vincoli
  description: 'Produzione F13: costi e vincoli I pp.14–23; riferimento e rollout I pp.24–25,35.'
  objective: Costi, prestazione e vincoli
  prerequisiteLessonIds:
  - C1.L2
  workspace:
    assetPath: Assets/OptimalControl/Scenes/LessonWorkspace.unity
  experiment: {fileID: 11400000, guid: 9dea7c89283f58e39f9a0087ec91cf3f, type: 2}
