%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: TransferDesired
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.transfer.desired
  schemaVersion: 1
  contentVersion: '1'
  title: Legge desiderata in secondi
  description: I p.35. Al bordo H/2 vale il secondo equilibrio. Il gradino desiderato non soddisfa la dinamica al
    salto. Griglie diverse campionano indipendentemente; nessuno switch fissato al campione 50.
  expression: 'τ<H/2: x_des=[θ_e¹,0], u_des=u_e¹

    τ≥H/2: x_des=[θ_e²,0], u_des=u_e²

    h_t^des=f(x_t^des,u_t^des)−x_(t+1)^des'
  sourceTranscription: 'τ<H/2: x_des=[θ_e¹,0], u_des=u_e¹

    τ≥H/2: x_des=[θ_e²,0], u_des=u_e²

    h_t^des=f(x_t^des,u_t^des)−x_(t+1)^des'
  assumptions: I p.35. Al bordo H/2 vale il secondo equilibrio. Il gradino desiderato non soddisfa la dinamica al
    salto. Griglie diverse campionano indipendentemente; nessuno switch fissato al campione 50.
  terms:
  - id: reference.state
    symbol: x_t^des
    label: Stato desiderato
    meaning: θ_e¹ prima di H/2, θ_e² da H/2 INCLUSO; ω_des=0. Ogni griglia campiona la stessa legge in secondi.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: reference.state
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: reference.state
      scope: 0
  - id: reference.input
    symbol: u_t^des
    label: Coppia desiderata
    meaning: mgl sinθ_e derivata dal modello autorevole; congelata all’apertura. Nessun u_N desiderato.
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: reference.input
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: desired-h
    symbol: h_t^des
    label: Residuo del desiderato
    meaning: f(x_t^des,u_t^des)−x_(t+1)^des. Il salto non è un rollout valido.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: constraint.desired-h
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.physical
    symbol: τ_t
    label: Tempo fisico
    meaning: Tempo del campione salvato. Nel pendolo τ_t=tδ; in una dinamica index-only è N/A.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.physical
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.step
    symbol: δ
    label: Passo fisico
    meaning: 'Passo fisico Euler e larghezza delle celle. H fisso: cambiare δ ricampiona N, input e riferimento.
      Non playback.'
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.step
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: duration
    symbol: H
    label: Durata fisica
    meaning: Durata T continuo della fonte, qui H per distinguerla da N transizioni.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: continuous.duration
      kind: 0
      scope: 4
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 4
  - id: transitions
    symbol: N
    label: Numero di transizioni
    meaning: N=T discreto; N+1 stati, N input. H=Nδ.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: continuous.transitions
      kind: 0
      scope: 4
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 4
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 31
    lastPhysicalPage: 36
    firstSlide: 30
    lastSlide: 35
    section: Problema continuo, pendolo, equilibri, desiderato e funzionale
    usage: 1
    note: 'H indica la durata T della fonte; N indica T discreto. Correzione p.34: velocità di equilibrio nulla.
      Costo p.36 SENZA ½. Quadratura rettangolo sinistro: scelta numerica F15, non formula esatta della fonte.'
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 27
    lastPhysicalPage: 27
    firstSlide: 26
    lastSlide: 26
    section: Forward Euler
    usage: 1
    note: Regola applicata al pendolo p.33; tutte le righe usano lo stato vecchio.
