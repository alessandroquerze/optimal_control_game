%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: DroneTerminal
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.drone.terminal
  schemaVersion: 1
  contentVersion: '1'
  title: T transizioni, T+1 stati
  description: L’output state-only e reference a T esistono. Next/input/stage e vincoli di percorso qui hanno dominio
    t<T. Nessun zero inventato.
  expression: 'T=50; τ_T=Tδ=1 s

    ℓ_tot=C_T+ℓ_T(x_T,x_T^des)

    u_T, u_T^des, x_(T+1), stage_T e g_T: N/A'
  sourceTranscription: 'T=50; τ_T=Tδ=1 s

    ℓ_tot=C_T+ℓ_T(x_T,x_T^des)

    u_T, u_T^des, x_(T+1), stage_T e g_T: N/A'
  assumptions: L’output state-only e reference a T esistono. Next/input/stage e vincoli di percorso qui hanno dominio
    t<T. Nessun zero inventato.
  terms:
  - id: state.current
    symbol: x_t
    label: Stato completo 6D
    meaning: '[px,vx,py,vy,θ,ω]. Non sei posizioni: unità diverse.'
    rows: 6
    columns: 1
    componentUnits:
    - m
    - m/s
    - m
    - m/s
    - rad
    - rad/s
    value:
      metricId: state.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.current
      scope: 0
  - id: output.current
    symbol: y_t
    label: Posizione osservata 2D
    meaning: h(x)=[px,py], non x. Velocità e assetto sono omessi.
    rows: 2
    columns: 1
    componentUnits:
    - m
    - m
    value:
      metricId: output.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: output.position
      scope: 0
  - id: input.applied
    symbol: u_t
    label: Vettore delle due spinte
    meaning: Vector(2), ordine [u₁,u₂], forze in N, non coppie. Somma e differenza accoppiano il moto.
    rows: 2
    columns: 1
    componentUnits:
    - N
    - N
    value:
      metricId: input.applied
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: input.applied
      scope: 0
  - id: state.next
    symbol: x_(t+1)
    label: Stato successivo
    meaning: Campione salvato @t+1; tutte le righe Euler usano x_t.
    rows: 6
    columns: 1
    componentUnits:
    - m
    - m/s
    - m
    - m/s
    - rad
    - rad/s
    value:
      metricId: state.next
      kind: 1
      scope: 1
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.next
      scope: 1
  - id: reference.input
    symbol: u_t^des
    label: Input desiderato zero
    meaning: 'I p.29 penalizza u₁²,u₂²: reference input [0,0]. NON il comando di hover.'
    rows: 2
    columns: 1
    componentUnits:
    - N
    - N
    value:
      metricId: reference.input
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: reference.state
    symbol: x_t^des
    label: Stato desiderato
    meaning: Sei componenti campionate; θ_des=ω_des=0. Curva non necessariamente fattibile.
    rows: 6
    columns: 1
    componentUnits:
    - m
    - m/s
    - m
    - m/s
    - rad
    - rad/s
    value:
      metricId: reference.state
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: reference.state
      scope: 0
  - id: reference.output
    symbol: y_t^des
    label: Posizione desiderata
    meaning: '[px_des,py_des], derivata dall’output del modello nella stessa revisione.'
    rows: 2
    columns: 1
    componentUnits:
    - m
    - m
    value:
      metricId: reference.output
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: stage
    symbol: ℓ_t
    label: Stage
    meaning: Somma pesata degli errori di sei stati e due spinte.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.stage
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: terminal
    symbol: ℓ_T
    label: Costo finale
    meaning: Q_T e reference al campione T; nessun input terminale.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.terminal
      kind: 0
      scope: 2
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 2
  - id: total
    symbol: ℓ_tot
    label: Indice di prestazione
    meaning: Somma dei T stage e del terminale. Diverso da J, momento d’inerzia. Costo adimensionale con pesi nelle
      unità inverse quadrate.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.total
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: g0
    symbol: g_0
    label: Residuo spinta u₁
    meaning: 'max(min−v,v−max)≤0: negativo dentro, zero sul bordo, positivo fuori. Diagnostica, nessuna saturazione.'
    rows: 1
    columns: 1
    componentUnits:
    - N
    value:
      metricId: constraint.g.thrust1
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: constraint.thrust1
      scope: 0
  - id: g1
    symbol: g_1
    label: Residuo spinta u₂
    meaning: 'max(min−v,v−max)≤0: negativo dentro, zero sul bordo, positivo fuori. Diagnostica, nessuna saturazione.'
    rows: 1
    columns: 1
    componentUnits:
    - N
    value:
      metricId: constraint.g.thrust2
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: constraint.thrust2
      scope: 0
  - id: g2
    symbol: g_2
    label: Residuo quota
    meaning: 'max(min−v,v−max)≤0: negativo dentro, zero sul bordo, positivo fuori. Diagnostica, nessuna saturazione.'
    rows: 1
    columns: 1
    componentUnits:
    - m
    value:
      metricId: constraint.g.altitude
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: constraint.altitude
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.physical
    symbol: τ_t
    label: Tempo fisico
    meaning: Tempo del campione salvato. Nel pendolo τ_t=tδ; in una dinamica index-only è N/A.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.physical
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.step
    symbol: δ
    label: Passo fisico
    meaning: Passo della discretizzazione (qui 0.02 s); non velocità di playback. Opzionale per altri modelli discreti.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.step
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 26
    lastPhysicalPage: 30
    firstSlide: 25
    lastSlide: 29
    section: Drone planare, Euler, costo e limiti
    usage: 1
    note: 'Fonte chiamata 3D, equazioni planari. Stato ordinato [px,vx,py,vy,θ,ω]. J è il momento d’inerzia. Costo
      diagonale discreto, input desiderato zero. Vincoli t=0…T−1 coerenti con I p.21: nessun input a T.'
