  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: ContinuousSystem
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.continuous-system
  schemaVersion: 1
  contentVersion: '1'
  title: Sistema continuo
  description: τ indica qui il tempo continuo, scritto t nella slide 7. I valori live sono campioni x_t=x(τ_t) dell’approssimazione
    Euler, non una soluzione continua esatta.
  expression: 'ẋ(τ) = f(x(τ),u(τ),τ)

    y(τ) = h(x(τ),u(τ),τ)'
  sourceTranscription: 'ẋ(τ) = f(x(τ),u(τ),τ)

    y(τ) = h(x(τ),u(τ),τ)'
  assumptions: τ indica qui il tempo continuo, scritto t nella slide 7. I valori live sono campioni x_t=x(τ_t) dell’approssimazione
    Euler, non una soluzione continua esatta.
  terms:
  - id: state.current
    symbol: x_t
    label: Stato completo
    meaning: 'x_t=[θ_t,ω_t]ᵀ: angolo e velocità angolare. Il corpo mostra solo θ; il punto di fase mostra entrambe.'
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: state.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.current
      scope: 0
  - id: input.applied
    symbol: u_t
    label: Input / coppia
    meaning: Coppia applicata alla transizione t→t+1; simbolo curvo, non forza lineare. Componente 0 esplicita del
      vettore input.
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: input.applied
      kind: 0
      scope: 0
      component: 0
      numericFormat: G6
    highlight:
      semanticRole: input.applied
      scope: 0
  - id: output.current
    symbol: y_t
    label: Output / angolo osservato
    meaning: 'In questo modello h_t(x_t,u_t)=θ_t: un output scalare selezionato dallo stato. In generale y NON coincide
      con x. Il corpo mostra lo stesso angolo osservato; il piano di fase mostra lo stato completo.'
    rows: 1
    columns: 1
    componentUnits:
    - rad
    value:
      metricId: output.current
      kind: 0
      scope: 0
      component: 0
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: derivative
    symbol: ẋ
    label: Derivata temporale
    meaning: Tasso istantaneo di variazione dello stato rispetto al tempo fisico τ. Nessuna derivata numerica runtime
      qui.
    rows: 1
    columns: 1
    componentUnits: []
    value:
      metricId: ''
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 8
    lastPhysicalPage: 8
    firstSlide: 7
    lastSlide: 7
    section: Sistema continuo
    usage: 1
    note: Uso di τ per distinguere il tempo fisico dall’indice discreto t.
