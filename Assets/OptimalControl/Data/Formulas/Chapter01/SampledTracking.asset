%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: SampledTracking
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.sampled-tracking
  schemaVersion: 1
  contentVersion: '1'
  title: Costo rispetto al campione desiderato
  description: 'Q diagonale semidefinita positiva, R diagonale definita positiva. Un peso cambia il criterio, non
    il rollout. Le unità inverse quadrate rendono J adimensionale; nessuna somma diretta di rad e rad/s. Errata
    I p.16: il secondo termine espanso usa w₂, non w₁.'
  expression: "e_t=x_t−x_t^des\nℓ_t=½Σ_i Q_ii (x_t[i]−x_t^des[i])²\n     +½Σ_j R_jj (u_t[j]−u_t^des[j])²"
  sourceTranscription: "e_t=x_t−x_t^des\nℓ_t=½Σ_i Q_ii (x_t[i]−x_t^des[i])²\n     +½Σ_j R_jj (u_t[j]−u_t^des[j])²"
  assumptions: 'Q diagonale semidefinita positiva, R diagonale definita positiva. Un peso cambia il criterio, non
    il rollout. Le unità inverse quadrate rendono J adimensionale; nessuna somma diretta di rad e rad/s. Errata
    I p.16: il secondo termine espanso usa w₂, non w₁.'
  terms:
  - id: state.current
    symbol: x_t
    label: Stato reale
    meaning: Rollout valido salvato; due componenti [θ,ω].
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: state.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.current
      scope: 0
  - id: reference.state
    symbol: x_t^des
    label: Stato desiderato
    meaning: Curva campionata, non necessariamente un rollout valido. [θ_des,ω_des], indice t.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: reference.state
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: reference.state
      scope: 0
  - id: input.applied
    symbol: u_t
    label: Controllo applicato
    meaning: 'T input, nessun u_T. Nessun attuatore/saturazione abilitato: richiesta e applicazione coincidono;
      il limite viene diagnosticato.'
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: input.applied
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: input.applied
      scope: 0
  - id: reference.input
    symbol: u_t^des
    label: Controllo desiderato
    meaning: Curva input desiderata della stessa revisione; non esiste u_T^des.
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: reference.input
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: error
    symbol: e_t
    label: Scarto di tracking
    meaning: x_t−x_t^des, già calcolato dal layer puro. Non è un residuo dinamico h né errore di linearizzazione
      F12.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: reference.state-error
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: stage
    symbol: ℓ_t
    label: Stage cost
    meaning: 'Contributo t=0…T−1: stato e controllo, reference dello stesso t.'
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.stage
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: cost.stage
      scope: 0
  - id: state-part
    symbol: ℓˣ_t
    label: Deviazione stato
    meaning: Contributo nominato state-deviation, non una penalità di vincolo.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.contribution.state-deviation
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: input-part
    symbol: ℓᵘ_t
    label: Deviazione controllo
    meaning: Contributo nominato control-deviation, R>0.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.contribution.control-deviation
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: Q0
    symbol: Q₀₀
    label: Peso angolo
    meaning: Peso non negativo dello scarto θ−θ_des; unità inverse quadrate, costo adimensionale.
    rows: 1
    columns: 1
    componentUnits:
    - 1/(rad)²
    value:
      metricId: parameter.cost.q.0
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: R0
    symbol: R₀₀
    label: Peso controllo
    meaning: Peso strettamente positivo dello scarto u−u_des; non un limite duro.
    rows: 1
    columns: 1
    componentUnits:
    - 1/(N·m)²
    value:
      metricId: parameter.cost.r.0
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 14
    lastPhysicalPage: 25
    firstSlide: 13
    lastSlide: 24
    section: Decisioni, costi, vincoli, reference e generazione di traiettorie
    usage: 0
    note: ''
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 35
    lastPhysicalPage: 35
    firstSlide: 34
    lastSlide: 34
    section: Riferimento a gradino fra equilibri
    usage: 1
    note: Campionamento discreto t=0…T; θ_des cambia al campione 10 su T=20; ω_des=0; u_des=mgl sin θ_des. La curva
      desiderata non soddisfa la dinamica al salto. Nessuna quadratura continua.
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 27
    lastPhysicalPage: 27
    firstSlide: 26
    lastSlide: 26
    section: Euler
    usage: 1
    note: Pendolo discreto già usato in C1.L1/L2, δ=.02 s.
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 33
    lastPhysicalPage: 34
    firstSlide: 32
    lastSlide: 33
    section: Pendolo ed equilibrio
    usage: 1
    note: 'Errata p.34: ω_e=0. Righe/colonne del Core invariati.'
