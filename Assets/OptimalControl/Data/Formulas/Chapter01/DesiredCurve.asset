%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: DesiredCurve
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.desired-curve
  schemaVersion: 1
  contentVersion: '1'
  title: Curva desiderata e rollout manuale
  description: Adattamento discreto del gradino I p.35. La formula a gradino descrive il PRESET; edit di campioni
    o modello non rigenerano le altre curve congelate. Nel preset ogni lato è un equilibrio, ma il salto non soddisfa
    la dinamica. Stato desiderato dimensione 2, output desiderato dimensione 1. Le guide tratteggiate non sono un’integrazione.
    Il rollout manuale non è automaticamente ottimo.
  expression: 'x_t^des=[θ_t^des,0]ᵀ; θ_t^des=0 (t<10), 0.5 (t≥10)

    Preset m=l=1,g=9.81: u_t^des=9.81 sin(θ_t^des), t<T

    y_t^des=h_t(x_t^des,u_t^des)=θ_t^des

    h_t^des=f_t(x_t^des,u_t^des)−x_(t+1)^des'
  sourceTranscription: 'x_t^des=[θ_t^des,0]ᵀ; θ_t^des=0 (t<10), 0.5 (t≥10)

    Preset m=l=1,g=9.81: u_t^des=9.81 sin(θ_t^des), t<T

    y_t^des=h_t(x_t^des,u_t^des)=θ_t^des

    h_t^des=f_t(x_t^des,u_t^des)−x_(t+1)^des'
  assumptions: Adattamento discreto del gradino I p.35. La formula a gradino descrive il PRESET; edit di campioni
    o modello non rigenerano le altre curve congelate. Nel preset ogni lato è un equilibrio, ma il salto non soddisfa
    la dinamica. Stato desiderato dimensione 2, output desiderato dimensione 1. Le guide tratteggiate non sono un’integrazione.
    Il rollout manuale non è automaticamente ottimo.
  terms:
  - id: reference.state
    symbol: x_t^des
    label: Stato desiderato
    meaning: Curva campionata, non necessariamente un rollout valido. [θ_des,ω_des], indice t.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: reference.state
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: reference.state
      scope: 0
  - id: reference.input
    symbol: u_t^des
    label: Controllo desiderato
    meaning: Curva input desiderata della stessa revisione; non esiste u_T^des.
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: reference.input
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: reference.output
    symbol: y_t^des
    label: Output desiderato
    meaning: h_t(x_t^des,u_t^des). In questo pendolo y_des=θ_des ha una componente; x_des ne ha due. NON y_des=x_des
      in generale.
    rows: 1
    columns: 1
    componentUnits:
    - rad
    value:
      metricId: reference.output
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: state.current
    symbol: x_t
    label: Stato reale
    meaning: Rollout valido salvato; due componenti [θ,ω].
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: state.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.current
      scope: 0
  - id: output.current
    symbol: y_t
    label: Output reale
    meaning: h_t(x_t,u_t)=θ_t in questo pendolo.
    rows: 1
    columns: 1
    componentUnits:
    - rad
    value:
      metricId: output.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: input.applied
    symbol: u_t
    label: Controllo applicato
    meaning: 'T input, nessun u_T. Nessun attuatore/saturazione abilitato: richiesta e applicazione coincidono;
      il limite viene diagnosticato.'
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: input.applied
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: input.applied
      scope: 0
  - id: desired-h
    symbol: h_t^des
    label: Residuo della curva desiderata
    meaning: f_t(x_t^des,u_t^des)−x_(t+1)^des. Al salto non è zero; questa curva non è una traiettoria valida.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: constraint.desired-h
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: h
    symbol: h_t
    label: Residuo dinamico reale
    meaning: f_t(x_t,u_t)−x_(t+1). Zero in ogni transizione del rollout; non è lo scarto dal desiderato.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: constraint.h
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.physical
    symbol: τ_t
    label: Tempo fisico
    meaning: Tempo del campione salvato. Nel pendolo τ_t=tδ; in una dinamica index-only è N/A.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.physical
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.step
    symbol: δ
    label: Passo fisico
    meaning: Passo della discretizzazione (qui 0.02 s); non velocità di playback. Opzionale per altri modelli discreti.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.step
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 14
    lastPhysicalPage: 25
    firstSlide: 13
    lastSlide: 24
    section: Decisioni, costi, vincoli, reference e generazione di traiettorie
    usage: 0
    note: ''
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 35
    lastPhysicalPage: 35
    firstSlide: 34
    lastSlide: 34
    section: Riferimento a gradino fra equilibri
    usage: 1
    note: Campionamento discreto t=0…T; θ_des cambia al campione 10 su T=20; ω_des=0; u_des=mgl sin θ_des. La curva
      desiderata non soddisfa la dinamica al salto. Nessuna quadratura continua.
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 27
    lastPhysicalPage: 27
    firstSlide: 26
    lastSlide: 26
    section: Euler
    usage: 1
    note: Pendolo discreto già usato in C1.L1/L2, δ=.02 s.
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 33
    lastPhysicalPage: 34
    firstSlide: 32
    lastSlide: 33
    section: Pendolo ed equilibrio
    usage: 1
    note: 'Errata p.34: ω_e=0. Righe/colonne del Core invariati.'
