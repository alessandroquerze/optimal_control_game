%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: DroneReference
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.drone.reference
  schemaVersion: 1
  contentVersion: '1'
  title: Riferimento e output desiderato
  description: Il preset descrive una curva campionata. Edit di un campione non rigenera gli altri. u_des=0 rende
    il riferimento non fattibile con gravità, benché la posizione appaia regolare. Nessun solver.
  expression: 'PRESET: p_x^des=.5τ; v_x^des=.5; p_y^des=1

    v_y^des=θ^des=ω^des=0; u^des=[0,0]ᵀ

    y^des=h(x^des)=[p_x^des,p_y^des]ᵀ

    h_t^des=f(x_t^des,u_t^des)−x_(t+1)^des'
  sourceTranscription: 'PRESET: p_x^des=.5τ; v_x^des=.5; p_y^des=1

    v_y^des=θ^des=ω^des=0; u^des=[0,0]ᵀ

    y^des=h(x^des)=[p_x^des,p_y^des]ᵀ

    h_t^des=f(x_t^des,u_t^des)−x_(t+1)^des'
  assumptions: Il preset descrive una curva campionata. Edit di un campione non rigenera gli altri. u_des=0 rende
    il riferimento non fattibile con gravità, benché la posizione appaia regolare. Nessun solver.
  terms:
  - id: reference.state
    symbol: x_t^des
    label: Stato desiderato
    meaning: Sei componenti campionate; θ_des=ω_des=0. Curva non necessariamente fattibile.
    rows: 6
    columns: 1
    componentUnits:
    - m
    - m/s
    - m
    - m/s
    - rad
    - rad/s
    value:
      metricId: reference.state
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: reference.state
      scope: 0
  - id: reference.output
    symbol: y_t^des
    label: Posizione desiderata
    meaning: '[px_des,py_des], derivata dall’output del modello nella stessa revisione.'
    rows: 2
    columns: 1
    componentUnits:
    - m
    - m
    value:
      metricId: reference.output
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: reference.input
    symbol: u_t^des
    label: Input desiderato zero
    meaning: 'I p.29 penalizza u₁²,u₂²: reference input [0,0]. NON il comando di hover.'
    rows: 2
    columns: 1
    componentUnits:
    - N
    - N
    value:
      metricId: reference.input
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: output.current
    symbol: y_t
    label: Posizione osservata 2D
    meaning: h(x)=[px,py], non x. Velocità e assetto sono omessi.
    rows: 2
    columns: 1
    componentUnits:
    - m
    - m
    value:
      metricId: output.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: output.position
      scope: 0
  - id: desired-h
    symbol: h_t^des
    label: Residuo dinamico desiderato
    meaning: f(x_des,u_des)−x_next_des salvato dal core. Non è lo scarto di tracking.
    rows: 6
    columns: 1
    componentUnits:
    - m
    - m/s
    - m
    - m/s
    - rad
    - rad/s
    value:
      metricId: constraint.desired-h
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.physical
    symbol: τ_t
    label: Tempo fisico
    meaning: Tempo del campione salvato. Nel pendolo τ_t=tδ; in una dinamica index-only è N/A.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.physical
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 26
    lastPhysicalPage: 30
    firstSlide: 25
    lastSlide: 29
    section: Drone planare, Euler, costo e limiti
    usage: 1
    note: 'Fonte chiamata 3D, equazioni planari. Stato ordinato [px,vx,py,vy,θ,ω]. J è il momento d’inerzia. Costo
      diagonale discreto, input desiderato zero. Vincoli t=0…T−1 coerenti con I p.21: nessun input a T.'
