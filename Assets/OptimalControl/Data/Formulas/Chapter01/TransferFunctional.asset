  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: TransferFunctional
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.transfer.functional
  schemaVersion: 1
  contentVersion: '1'
  title: Da una funzione a un numero
  description: 'I pp.31–32: problema su funzioni, non ricerca già eseguita. H è il T continuo della fonte. I live
    value appartengono all’approssimazione J^δ, non al vero J_c.'
  expression: 'J_c=∫₀ᴴ L(x(τ),u(τ),τ)dτ+Φ(x(H))

    ẋ=f_CT(x,u); x(0)=x⁰'
  sourceTranscription: 'J_c=∫₀ᴴ L(x(τ),u(τ),τ)dτ+Φ(x(H))

    ẋ=f_CT(x,u); x(0)=x⁰'
  assumptions: 'I pp.31–32: problema su funzioni, non ricerca già eseguita. H è il T continuo della fonte. I live
    value appartengono all’approssimazione J^δ, non al vero J_c.'
  terms:
  - id: duration
    symbol: H
    label: Durata fisica
    meaning: Durata T continuo della fonte, qui H per distinguerla da N transizioni.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: continuous.duration
      kind: 0
      scope: 4
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 4
  - id: total
    symbol: J^δ
    label: Approssimazione del funzionale
    meaning: C_N+Φ; quadratura e rollout Euler sono approssimazioni. Non costo minimo certificato.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: continuous.total
      kind: 0
      scope: 4
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 4
  - id: density
    symbol: L_t
    label: Densità running
    meaning: L(x_t,u_t,τ_t) [1/s], NON il contributo integrato. Solo t<N.
    rows: 1
    columns: 1
    componentUnits:
    - 1/s
    value:
      metricId: continuous.density
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: cost.density
      scope: 0
  - id: terminal
    symbol: Φ
    label: Costo terminale
    meaning: Valutazione di x_N rispetto al reference finale; una sola volta, senza δ e senza u_N.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: continuous.terminal
      kind: 0
      scope: 2
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: cost.terminal
      scope: 2
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 31
    lastPhysicalPage: 36
    firstSlide: 30
    lastSlide: 35
    section: Problema continuo, pendolo, equilibri, desiderato e funzionale
    usage: 1
    note: 'H indica la durata T della fonte; N indica T discreto. Correzione p.34: velocità di equilibrio nulla.
      Costo p.36 SENZA ½. Quadratura rettangolo sinistro: scelta numerica F15, non formula esatta della fonte.'
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 27
    lastPhysicalPage: 27
    firstSlide: 26
    lastSlide: 26
    section: Forward Euler
    usage: 1
    note: Regola applicata al pendolo p.33; tutte le righe usano lo stato vecchio.
  layout:
    rootId: r
    nodes:
    - id: r
      kind: 2
      children:
      - j
      - eq
      - integral
      - plus
      - phi
    - id: j
      kind: 0
      text: J_c
    - id: eq
      kind: 0
      text: '='
    - id: integral
      kind: 6
      children:
      - zero
      - h
      - l
    - id: zero
      kind: 0
      text: '0'
    - id: h
      kind: 1
      termId: duration
    - id: l
      kind: 0
      text: L(x(τ),u(τ),τ) dτ
    - id: plus
      kind: 0
      text: +
    - id: phi
      kind: 1
      termId: terminal
