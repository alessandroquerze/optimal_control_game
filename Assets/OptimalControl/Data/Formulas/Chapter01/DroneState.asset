%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: DroneState
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.drone.state
  schemaVersion: 1
  contentVersion: '1'
  title: Stato 6D, due spinte e output
  description: n=6, m=2, p=2. Modello planare, non quadrotor 3D. Due stati alla stessa posizione possono avere futuro
    e costo diversi.
  expression: 'x_t=[p_x,v_x,p_y,v_y,θ,ω]ᵀ

    u_t=[u₁,u₂]ᵀ; y_t=h(x_t)=[p_x,p_y]ᵀ'
  sourceTranscription: 'x_t=[p_x,v_x,p_y,v_y,θ,ω]ᵀ

    u_t=[u₁,u₂]ᵀ; y_t=h(x_t)=[p_x,p_y]ᵀ'
  assumptions: n=6, m=2, p=2. Modello planare, non quadrotor 3D. Due stati alla stessa posizione possono avere futuro
    e costo diversi.
  terms:
  - id: state.current
    symbol: x_t
    label: Stato completo 6D
    meaning: '[px,vx,py,vy,θ,ω]. Non sei posizioni: unità diverse.'
    rows: 6
    columns: 1
    componentUnits:
    - m
    - m/s
    - m
    - m/s
    - rad
    - rad/s
    value:
      metricId: state.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.current
      scope: 0
  - id: input.applied
    symbol: u_t
    label: Vettore delle due spinte
    meaning: Vector(2), ordine [u₁,u₂], forze in N, non coppie. Somma e differenza accoppiano il moto.
    rows: 2
    columns: 1
    componentUnits:
    - N
    - N
    value:
      metricId: input.applied
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: input.applied
      scope: 0
  - id: output.current
    symbol: y_t
    label: Posizione osservata 2D
    meaning: h(x)=[px,py], non x. Velocità e assetto sono omessi.
    rows: 2
    columns: 1
    componentUnits:
    - m
    - m
    value:
      metricId: output.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: output.position
      scope: 0
  - id: x0
    symbol: p_x_t
    label: Posizione orizzontale
    meaning: 'Componente 0 dello stato. Zero θ: body orizzontale; piano fisico XY.'
    rows: 1
    columns: 1
    componentUnits:
    - m
    value:
      metricId: state.current
      kind: 0
      scope: 0
      component: 0
      numericFormat: G6
    highlight:
      semanticRole: state.component.0
      scope: 0
  - id: x1
    symbol: v_x_t
    label: Velocità orizzontale
    meaning: 'Componente 1 dello stato. Zero θ: body orizzontale; piano fisico XY.'
    rows: 1
    columns: 1
    componentUnits:
    - m/s
    value:
      metricId: state.current
      kind: 0
      scope: 0
      component: 1
      numericFormat: G6
    highlight:
      semanticRole: state.component.1
      scope: 0
  - id: x2
    symbol: p_y_t
    label: Quota
    meaning: 'Componente 2 dello stato. Zero θ: body orizzontale; piano fisico XY.'
    rows: 1
    columns: 1
    componentUnits:
    - m
    value:
      metricId: state.current
      kind: 0
      scope: 0
      component: 2
      numericFormat: G6
    highlight:
      semanticRole: state.component.2
      scope: 0
  - id: x3
    symbol: v_y_t
    label: Velocità verticale
    meaning: 'Componente 3 dello stato. Zero θ: body orizzontale; piano fisico XY.'
    rows: 1
    columns: 1
    componentUnits:
    - m/s
    value:
      metricId: state.current
      kind: 0
      scope: 0
      component: 3
      numericFormat: G6
    highlight:
      semanticRole: state.component.3
      scope: 0
  - id: x4
    symbol: θ_t
    label: Assetto positivo antiorario
    meaning: 'Componente 4 dello stato. Zero θ: body orizzontale; piano fisico XY.'
    rows: 1
    columns: 1
    componentUnits:
    - rad
    value:
      metricId: state.current
      kind: 0
      scope: 0
      component: 4
      numericFormat: G6
    highlight:
      semanticRole: state.component.4
      scope: 0
  - id: x5
    symbol: ω_t
    label: Velocità angolare
    meaning: 'Componente 5 dello stato. Zero θ: body orizzontale; piano fisico XY.'
    rows: 1
    columns: 1
    componentUnits:
    - rad/s
    value:
      metricId: state.current
      kind: 0
      scope: 0
      component: 5
      numericFormat: G6
    highlight:
      semanticRole: state.component.5
      scope: 0
  - id: u1
    symbol: u₁,t
    label: Spinta destra
    meaning: Componente 0 ESPLICITA di input.applied Vector(2). Forza normale al body, non asse x.
    rows: 1
    columns: 1
    componentUnits:
    - N
    value:
      metricId: input.applied
      kind: 0
      scope: 0
      component: 0
      numericFormat: G6
    highlight:
      semanticRole: input.thrust1
      scope: 0
  - id: u2
    symbol: u₂,t
    label: Spinta sinistra
    meaning: Componente 1 ESPLICITA di input.applied Vector(2). La differenza produce momento.
    rows: 1
    columns: 1
    componentUnits:
    - N
    value:
      metricId: input.applied
      kind: 0
      scope: 0
      component: 1
      numericFormat: G6
    highlight:
      semanticRole: input.thrust2
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.physical
    symbol: τ_t
    label: Tempo fisico
    meaning: Tempo del campione salvato. Nel pendolo τ_t=tδ; in una dinamica index-only è N/A.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.physical
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.step
    symbol: δ
    label: Passo fisico
    meaning: Passo della discretizzazione (qui 0.02 s); non velocità di playback. Opzionale per altri modelli discreti.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.step
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 26
    lastPhysicalPage: 30
    firstSlide: 25
    lastSlide: 29
    section: Drone planare, Euler, costo e limiti
    usage: 1
    note: 'Fonte chiamata 3D, equazioni planari. Stato ordinato [px,vx,py,vy,θ,ω]. J è il momento d’inerzia. Costo
      diagonale discreto, input desiderato zero. Vincoli t=0…T−1 coerenti con I p.21: nessun input a T.'
  layout:
    rootId: r
    nodes:
    - id: r
      kind: 2
      children:
      - xt
      - eq
      - v
    - id: xt
      kind: 1
      termId: state.current
    - id: eq
      kind: 0
      text: '='
    - id: v
      kind: 7
      rows: 6
      columns: 1
      children:
      - c0
      - c1
      - c2
      - c3
      - c4
      - c5
    - id: c0
      kind: 1
      termId: x0
    - id: c1
      kind: 1
      termId: x1
    - id: c2
      kind: 1
      termId: x2
    - id: c3
      kind: 1
      termId: x3
    - id: c4
      kind: 1
      termId: x4
    - id: c5
      kind: 1
      termId: x5
