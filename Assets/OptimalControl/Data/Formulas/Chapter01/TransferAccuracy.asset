  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: TransferAccuracy
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.transfer.accuracy
  schemaVersion: 1
  contentVersion: '1'
  title: Un oracolo indipendente per Euler
  description: 'Adattamento didattico con soluzione analitica indipendente. H=2, m=l=u=1: θ(H)=2; δ=.1 → e=−.1,
    δ=.05 → e=−.05. Non generalizzare monotonia a ogni input/nonlinearità. Reference di trasferimento resta congelata
    al modello d’apertura.'
  expression: 'CASO SPECIALE: g=0, u costante

    θ(H)=θ0+ω0H+uH²/(2ml²); ω(H)=ω0+uH/(ml²)

    e_θ,N=θ_N^Euler−θ(H)'
  sourceTranscription: 'CASO SPECIALE: g=0, u costante

    θ(H)=θ0+ω0H+uH²/(2ml²); ω(H)=ω0+uH/(ml²)

    e_θ,N=θ_N^Euler−θ(H)'
  assumptions: 'Adattamento didattico con soluzione analitica indipendente. H=2, m=l=u=1: θ(H)=2; δ=.1 → e=−.1,
    δ=.05 → e=−.05. Non generalizzare monotonia a ogni input/nonlinearità. Reference di trasferimento resta congelata
    al modello d’apertura.'
  terms:
  - id: oracle-error
    symbol: e_θ,N
    label: Errore Euler verificabile
    meaning: 'Solo caso didattico g=0 e coppia costante: θ(H)=θ0+ω0H+½uH²/(ml²). Altrove N/A; nessuna soluzione
      esatta nonlineare.'
    rows: 1
    columns: 1
    componentUnits:
    - rad
    value:
      metricId: continuous.accuracy-angle-error
      kind: 0
      scope: 4
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 4
  - id: duration
    symbol: H
    label: Durata fisica
    meaning: Durata T continuo della fonte, qui H per distinguerla da N transizioni.
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: continuous.duration
      kind: 0
      scope: 4
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 4
  - id: transitions
    symbol: N
    label: Numero di transizioni
    meaning: N=T discreto; N+1 stati, N input. H=Nδ.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: continuous.transitions
      kind: 0
      scope: 4
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 4
  - id: time.step
    symbol: δ
    label: Passo fisico
    meaning: 'Passo fisico Euler e larghezza delle celle. H fisso: cambiare δ ricampiona N, input e riferimento.
      Non playback.'
    rows: 1
    columns: 1
    componentUnits:
    - s
    value:
      metricId: time.step
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: total
    symbol: J^δ
    label: Approssimazione del funzionale
    meaning: C_N+Φ; quadratura e rollout Euler sono approssimazioni. Non costo minimo certificato.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: continuous.total
      kind: 0
      scope: 4
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 4
  - id: same-problem
    symbol: P_A=P_B
    label: Stesso problema fisico
    meaning: 'Confronto autorevole: stessi H, modello/parametri/x0, leggi input/reference, pesi e terminale. Soltanto
      δ/N differiscono.'
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: continuous.comparison.same-problem
      kind: 0
      scope: 4
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 4
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 31
    lastPhysicalPage: 36
    firstSlide: 30
    lastSlide: 35
    section: Problema continuo, pendolo, equilibri, desiderato e funzionale
    usage: 1
    note: 'H indica la durata T della fonte; N indica T discreto. Correzione p.34: velocità di equilibrio nulla.
      Costo p.36 SENZA ½. Quadratura rettangolo sinistro: scelta numerica F15, non formula esatta della fonte.'
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 27
    lastPhysicalPage: 27
    firstSlide: 26
    lastSlide: 26
    section: Forward Euler
    usage: 1
    note: Regola applicata al pendolo p.33; tutte le righe usano lo stato vecchio.
