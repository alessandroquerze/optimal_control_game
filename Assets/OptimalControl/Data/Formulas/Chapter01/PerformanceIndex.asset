%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: PerformanceIndex
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.performance-index
  schemaVersion: 1
  contentVersion: '1'
  title: Decisioni e indice di prestazione
  description: 'Somma discreta: nessun fattore δ o quadratura. ℓ_T separato; x₀ fissato non è una variabile di decisione.
    Il rollout manuale costruisce una coppia valida, non minimizza J.'
  expression: 'z=col(x₁,…,x_T,u₀,…,u_(T−1)); x₀ fissato

    J=Σ_(t=0)^(T−1) ℓ_t(x_t,u_t)+ℓ_T(x_T)

    C_t=Σ_(k=0)^(t−1) ℓ_k'
  sourceTranscription: 'z=col(x₁,…,x_T,u₀,…,u_(T−1)); x₀ fissato

    J=Σ_(t=0)^(T−1) ℓ_t(x_t,u_t)+ℓ_T(x_T)

    C_t=Σ_(k=0)^(t−1) ℓ_k'
  assumptions: 'Somma discreta: nessun fattore δ o quadratura. ℓ_T separato; x₀ fissato non è una variabile di decisione.
    Il rollout manuale costruisce una coppia valida, non minimizza J.'
  terms:
  - id: stage
    symbol: ℓ_t
    label: Stage cost
    meaning: 'Contributo t=0…T−1: stato e controllo, reference dello stesso t.'
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.stage
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: cost.stage
      scope: 0
  - id: terminal
    symbol: ℓ_T
    label: Costo terminale
    meaning: Usa x_T e x_T^des, non un input inventato.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.terminal
      kind: 0
      scope: 2
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: cost.terminal
      scope: 2
  - id: total
    symbol: J
    label: Indice di prestazione
    meaning: Somma di T stage + un terminale; sotto il proprio criterio immutabile.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.total
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: cumulative
    symbol: C_t
    label: Costo già percorso
    meaning: Somma degli stage prima di t; esclude lo stage corrente e il terminale.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.cumulative
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: state.current
    symbol: x_t
    label: Stato reale
    meaning: Rollout valido salvato; due componenti [θ,ω].
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: state.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.current
      scope: 0
  - id: input.applied
    symbol: u_t
    label: Controllo applicato
    meaning: 'T input, nessun u_T. Nessun attuatore/saturazione abilitato: richiesta e applicazione coincidono;
      il limite viene diagnosticato.'
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: input.applied
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: input.applied
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 14
    lastPhysicalPage: 25
    firstSlide: 13
    lastSlide: 24
    section: Decisioni, costi, vincoli, reference e generazione di traiettorie
    usage: 0
    note: ''
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 35
    lastPhysicalPage: 35
    firstSlide: 34
    lastSlide: 34
    section: Riferimento a gradino fra equilibri
    usage: 1
    note: Campionamento discreto t=0…T; θ_des cambia al campione 10 su T=20; ω_des=0; u_des=mgl sin θ_des. La curva
      desiderata non soddisfa la dinamica al salto. Nessuna quadratura continua.
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 27
    lastPhysicalPage: 27
    firstSlide: 26
    lastSlide: 26
    section: Euler
    usage: 1
    note: Pendolo discreto già usato in C1.L1/L2, δ=.02 s.
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 33
    lastPhysicalPage: 34
    firstSlide: 32
    lastSlide: 33
    section: Pendolo ed equilibrio
    usage: 1
    note: 'Errata p.34: ω_e=0. Righe/colonne del Core invariati.'
  layout:
    rootId: sum-row
    nodes:
    - id: sum-row
      kind: 2
      children:
      - j
      - eq
      - sum
      - plus
      - terminal
    - id: j
      kind: 1
      termId: total
    - id: eq
      kind: 0
      text: '='
    - id: sum
      kind: 5
      children:
      - stage
      - lower
      - upper
    - id: stage
      kind: 1
      termId: stage
    - id: lower
      kind: 0
      text: t=0
    - id: upper
      kind: 0
      text: T−1
    - id: plus
      kind: 0
      text: +
    - id: terminal
      kind: 1
      termId: terminal
