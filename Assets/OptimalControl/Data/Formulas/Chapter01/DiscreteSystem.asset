MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: DiscreteSystem
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.discrete-system
  schemaVersion: 1
  contentVersion: '1'
  title: Transizione discreta
  description: T transizioni, T input, T+1 stati. Il prossimo stato è già salvato; t non è una durata.
  expression: 'x_(t+1) = f_t(x_t,u_t)

    x₀ = x⁰'
  sourceTranscription: 'x_(t+1) = f_t(x_t,u_t)

    x₀ = x⁰'
  assumptions: T transizioni, T input, T+1 stati. Il prossimo stato è già salvato; t non è una durata.
  terms:
  - id: state.current
    symbol: x_t
    label: Stato completo
    meaning: 'x_t=[θ_t,ω_t]ᵀ: angolo e velocità angolare. Il corpo mostra solo θ; il punto di fase mostra entrambe.'
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: state.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.current
      scope: 0
  - id: input.applied
    symbol: u_t
    label: Input / coppia
    meaning: Coppia applicata alla transizione t→t+1; simbolo curvo, non forza lineare. Componente 0 esplicita del
      vettore input.
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: input.applied
      kind: 0
      scope: 0
      component: 0
      numericFormat: G6
    highlight:
      semanticRole: input.applied
      scope: 0
  - id: state.next
    symbol: x_(t+1)
    label: Stato successivo
    meaning: Campione salvato @t+1 della stessa revisione; non esiste oltre T.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: state.next
      kind: 1
      scope: 1
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.next
      scope: 1
  - id: output.current
    symbol: y_t
    label: Output / angolo osservato
    meaning: 'In questo modello h_t(x_t,u_t)=θ_t: un output scalare selezionato dallo stato. In generale y NON coincide
      con x. Il corpo mostra lo stesso angolo osservato; il piano di fase mostra lo stato completo.'
    rows: 1
    columns: 1
    componentUnits:
    - rad
    value:
      metricId: output.current
      kind: 0
      scope: 0
      component: 0
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 9
    lastPhysicalPage: 10
    firstSlide: 8
    lastSlide: 9
    section: Sistema discreto e orizzonte
    usage: 0
    note: ''
