%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: TerminalTracking
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.terminal-tracking
  schemaVersion: 1
  contentVersion: '1'
  title: Costo terminale distinto
  description: Q_T semidefinita positiva. Penalizza l’esito a T; non impone da sola una uguaglianza terminale. Riferimento
    terminale esplicito della stessa revisione.
  expression: 'ℓ_T(x_T)=½Σ_i Q_T,ii (x_T[i]−x_T^des[i])²

    J=C_T+ℓ_T; nessun u_T'
  sourceTranscription: 'ℓ_T(x_T)=½Σ_i Q_T,ii (x_T[i]−x_T^des[i])²

    J=C_T+ℓ_T; nessun u_T'
  assumptions: Q_T semidefinita positiva. Penalizza l’esito a T; non impone da sola una uguaglianza terminale. Riferimento
    terminale esplicito della stessa revisione.
  terms:
  - id: state.terminal
    symbol: x_T
    label: Stato terminale
    meaning: Campione T del rollout valido.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: state.current
      kind: 1
      scope: 2
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.terminal
      scope: 2
  - id: reference.terminal
    symbol: x_T^des
    label: Riferimento terminale
    meaning: Campione T della curva desiderata, non default corrente o riferimento di un’altra revisione.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: reference.state
      kind: 1
      scope: 2
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 2
  - id: terminal
    symbol: ℓ_T
    label: Costo terminale
    meaning: Usa x_T e x_T^des, non un input inventato.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.terminal
      kind: 0
      scope: 2
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: cost.terminal
      scope: 2
  - id: QT0
    symbol: Q_T,₀₀
    label: Peso terminale
    meaning: Peso non negativo sullo scarto finale di angolo.
    rows: 1
    columns: 1
    componentUnits:
    - 1/(rad)²
    value:
      metricId: parameter.cost.qt.0
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: total
    symbol: J
    label: Indice di prestazione
    meaning: Somma di T stage + un terminale; sotto il proprio criterio immutabile.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.total
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: stage
    symbol: ℓ_t
    label: Stage cost
    meaning: 'Contributo t=0…T−1: stato e controllo, reference dello stesso t.'
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: cost.stage
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: cost.stage
      scope: 0
  - id: input.applied
    symbol: u_t
    label: Controllo applicato
    meaning: 'T input, nessun u_T. Nessun attuatore/saturazione abilitato: richiesta e applicazione coincidono;
      il limite viene diagnosticato.'
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: input.applied
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: input.applied
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 14
    lastPhysicalPage: 25
    firstSlide: 13
    lastSlide: 24
    section: Decisioni, costi, vincoli, reference e generazione di traiettorie
    usage: 0
    note: ''
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 35
    lastPhysicalPage: 35
    firstSlide: 34
    lastSlide: 34
    section: Riferimento a gradino fra equilibri
    usage: 1
    note: Campionamento discreto t=0…T; θ_des cambia al campione 10 su T=20; ω_des=0; u_des=mgl sin θ_des. La curva
      desiderata non soddisfa la dinamica al salto. Nessuna quadratura continua.
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 27
    lastPhysicalPage: 27
    firstSlide: 26
    lastSlide: 26
    section: Euler
    usage: 1
    note: Pendolo discreto già usato in C1.L1/L2, δ=.02 s.
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 33
    lastPhysicalPage: 34
    firstSlide: 32
    lastSlide: 33
    section: Pendolo ed equilibrio
    usage: 1
    note: 'Errata p.34: ω_e=0. Righe/colonne del Core invariati.'
