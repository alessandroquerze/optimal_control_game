  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: SystemTrajectory
  m_EditorClassIdentifier: OptCon.Content::OptCon.Content.FormulaDefinition
  id: c1.trajectory
  schemaVersion: 1
  contentVersion: '1'
  title: Coppia stato-input valida
  description: La successione di stati da sola non specifica gli input. Il grafico (θ,ω) è una proiezione della
    traiettoria stato-input; la curva 3D aggiunge τ, non una posizione fisica.
  expression: (x̄,ū) è una traiettoria ⇔ x̄_(t+1)=f_t(x̄_t,ū_t), t=0,…,T−1
  sourceTranscription: (x̄,ū) è una traiettoria ⇔ x̄_(t+1)=f_t(x̄_t,ū_t), t=0,…,T−1
  assumptions: La successione di stati da sola non specifica gli input. Il grafico (θ,ω) è una proiezione della
    traiettoria stato-input; la curva 3D aggiunge τ, non una posizione fisica.
  terms:
  - id: state.current
    symbol: x_t
    label: Stato del rollout vero
    meaning: Campione nonlineare salvato; blu. La curva di fase non è il percorso fisico del corpo.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: state.current
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: state.current
      scope: 0
  - id: input.applied
    symbol: u_t
    label: Input della transizione
    meaning: Coppia applicata; la traiettoria include la successione degli input oltre a quella degli stati.
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: input.applied
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: input.applied
      scope: 0
  - id: nominal.state
    symbol: x̄_t
    label: Stato nominale
    meaning: Campione della traiettoria valida salvata. La barra indica il punto di sviluppo, non un target desiderato.
    rows: 2
    columns: 1
    componentUnits:
    - rad
    - rad/s
    value:
      metricId: linearization.nominal-state
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: linearization.nominal
      scope: 0
  - id: nominal.input
    symbol: ū_t
    label: Input nominale
    meaning: Controllo salvato con la nominale; serve a definire Δu. Non esiste ū_T.
    rows: 1
    columns: 1
    componentUnits:
    - N·m
    value:
      metricId: linearization.nominal-input
      kind: 1
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  - id: time.index
    symbol: t
    label: Indice discreto
    meaning: Numero del campione 0…T, non secondi. Esiste anche in una dinamica index-only.
    rows: 1
    columns: 1
    componentUnits:
    - '1'
    value:
      metricId: time.index
      kind: 0
      scope: 0
      component: -1
      numericFormat: G6
    highlight:
      semanticRole: ''
      scope: 0
  sources:
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 10
    lastPhysicalPage: 13
    firstSlide: 9
    lastSlide: 12
    section: Traiettorie, equilibri e linearizzazione
    usage: 0
    note: ''
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 27
    lastPhysicalPage: 27
    firstSlide: 26
    lastSlide: 26
    section: Forward Euler
    usage: 1
    note: Adattamento del pendolo continuo alla discretizzazione già usata in F11.
  - document: {fileID: 11400000, guid: 8caf86dcfb234a9a9dae0d453862bc08, type: 2}
    firstPhysicalPage: 33
    lastPhysicalPage: 34
    firstSlide: 32
    lastSlide: 33
