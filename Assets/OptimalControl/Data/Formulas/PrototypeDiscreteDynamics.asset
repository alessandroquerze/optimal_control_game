%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e039087c2f4e1ab6f8639bc051389d, type: 3}
  m_Name: "PrototypeDiscreteDynamics"
  m_EditorClassIdentifier: "OptCon.Content::OptCon.Content.FormulaDefinition"
  id: "prototype.pendulum.discrete"
  schemaVersion: 1
  contentVersion: "1"
  title: "Una transizione discreta"
  description: "Definizione dei quattro termini per il prototipo a due stati; nessun calcolo o valore live contenuto nell’asset."
  expression: "x_(t+1) = f_t(x_t, u_t)"
  sourceTranscription: "x_(t+1) = f_t(x_t,u_t), x_0 = x⁰"
  assumptions: "t = 0,…,T−1; x_t = [θ_t,ω_t]ᵀ, u_t è una coppia. Euler esplicito usa lo stato precedente per entrambe le componenti. Nel terminale non esistono input o stato successivo."
  terms:
    - id: "state.current"
      symbol: "x_t"
      label: "Stato corrente"
      meaning: "θ_t è l’angolo e ω_t la velocità angolare; la posizione da sola non descrive tutto lo stato."
      rows: 2
      columns: 1
      componentUnits:
        - "rad"
        - "rad/s"
      value:
        metricId: "state.current"
        kind: 1
        scope: 0
        component: -1
        numericFormat: "G6"
      highlight:
        semanticRole: "state.current"
        scope: 0
    - id: "input.applied"
      symbol: "u_t"
      label: "Controllo applicato"
      meaning: "Coppia applicata sulla transizione dal campione t al campione t+1."
      rows: 1
      columns: 1
      componentUnits:
        - "N·m"
      value:
        metricId: "input.applied"
        kind: 0
        scope: 0
        component: -1
        numericFormat: "G6"
      highlight:
        semanticRole: "input.applied"
        scope: 0
    - id: "dynamics.model"
      symbol: "f_t"
      label: "Modello della dinamica"
      meaning: "Descrittore del modello e dei suoi parametri; non è un valore numerico fittizio."
      rows: 0
      columns: 0
      componentUnits: []
      value:
        metricId: "dynamics.model"
        kind: 3
        scope: 0
        component: -1
        numericFormat: "G6"
      highlight:
        semanticRole: "dynamics.transition"
        scope: 0
    - id: "state.next"
      symbol: "x_(t+1)"
      label: "Stato successivo"
      meaning: "Stato al campione t+1; lo scope indica lo stesso campione già descritto da state.next, senza un secondo incremento."
      rows: 2
      columns: 1
      componentUnits:
        - "rad"
        - "rad/s"
      value:
        metricId: "state.next"
        kind: 1
        scope: 1
        component: -1
        numericFormat: "G6"
      highlight:
        semanticRole: "state.next"
        scope: 1
  sources:
