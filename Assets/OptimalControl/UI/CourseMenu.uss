.shell { flex-grow: 1; padding: 28px; align-items: center; justify-content: center; background-color: rgb(19, 25, 36); color: rgb(235, 241, 248); }
.shell.workspace { align-items: flex-start; justify-content: flex-start; background-color: rgba(0, 0, 0, 0); }
.menu-panel { width: 800px; max-width: 100%; max-height: 100%; flex-shrink: 1; }
.eyebrow { font-size: 12px; color: rgb(112, 205, 215); margin-bottom: 12px; white-space: normal; }
.badge { font-size: 11px; color: rgb(196, 179, 137); margin-bottom: 6px; }
.course-title { font-size: 30px; -unity-font-style: bold; white-space: normal; margin-bottom: 10px; }
.description { font-size: 16px; white-space: normal; margin-bottom: 14px; color: rgb(206, 216, 231); }
.section-title { font-size: 17px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 8px; }
.chapter-list { flex-shrink: 0; min-height: 80px; }
.chapter { margin-bottom: 16px; }
.chapter-title { font-size: 16px; white-space: normal; margin-bottom: 8px; }
.lesson-button { min-height: 50px; margin: 3px 0; padding: 10px 16px; font-size: 16px; white-space: normal; -unity-text-align: middle-left; color: rgb(239, 247, 255); background-color: rgb(37, 57, 78); border-radius: 6px; border-width: 1px; border-color: rgb(68, 95, 121); }
.lesson-button:hover { background-color: rgb(48, 75, 98); }
.lesson-button:focus, .back-button:focus { border-color: rgb(112, 205, 215); border-width: 2px; }
.lesson-button:disabled, .back-button:disabled { opacity: 0.55; }
.lesson-panel { display: none; width: 420px; max-width: 100%; flex-shrink: 1; padding: 22px; background-color: rgba(19, 25, 36, 0.95); border-radius: 8px; }
.lesson-title { font-size: 24px; -unity-font-style: bold; white-space: normal; margin-bottom: 12px; }
.back-button { min-height: 38px; margin-bottom: 20px; padding: 8px 12px; color: rgb(239, 247, 255); background-color: rgb(37, 57, 78); border-width: 1px; border-color: rgb(68, 95, 121); }
.note { font-size: 13px; white-space: normal; color: rgb(169, 185, 205); margin-top: 12px; }
.status { font-size: 14px; white-space: normal; color: rgb(255, 205, 146); margin-top: 10px; max-width: 800px; }
