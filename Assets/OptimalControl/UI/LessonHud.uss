.lesson-hud { margin-top: 4px; color: rgb(235, 241, 248); }
.lesson-hud .eyebrow { margin-top: 6px; margin-bottom: 3px; font-size: 10px; }
.hud-note { font-size: 12px; white-space: normal; color: rgb(185, 201, 219); margin: 3px 0; }
.transport { flex-direction: row; margin: 3px 0; }
.transport Button { flex-grow: 1; min-height: 26px; margin: 0 2px; font-size: 12px; }
.formula-expression { font-size: 16px; -unity-font-style: bold; white-space: normal; margin: 6px 0; }
.term { padding: 4px 7px; margin: 2px 0; background-color: rgb(30, 44, 62); border-width: 1px; border-color: rgb(67, 88, 110); border-radius: 4px; -unity-text-align: middle-left; }
.term-name { font-size: 12px; -unity-font-style: bold; white-space: normal; }
.term-value { font-size: 12px; white-space: normal; color: rgb(141, 218, 231); margin-top: 2px; }
.term.selected { border-color: rgb(255, 226, 111); background-color: rgb(52, 54, 54); }
.term.unavailable .term-value { color: rgb(206, 188, 161); }
.term:focus { border-width: 2px; border-color: rgb(255, 226, 111); }
.term-detail { padding: 7px; margin-top: 6px; border-left-width: 3px; border-left-color: rgb(255, 226, 111); background-color: rgb(26, 37, 51); }
.lesson-hud .unity-base-field__label { min-width: 115px; font-size: 12px; }
.lesson-hud .unity-foldout { margin-top: 4px; }
.lesson-hud Button { background-color: rgb(37, 57, 78); color: rgb(239, 247, 255); border-width: 1px; border-color: rgb(68, 95, 121); }
.lesson-hud Button:hover { background-color: rgb(48, 75, 98); }
.lesson-hud Button:focus { border-color: rgb(255, 226, 111); }
.lesson-hud Button:disabled { opacity: 0.45; }
.lesson-hud .unity-base-field__input { background-color: rgb(37, 57, 78); color: rgb(239, 247, 255); }
.lesson-hud .unity-base-popup-field__text { color: rgb(239, 247, 255); }
.lesson-hud .unity-text-field__input { background-color: rgb(37, 57, 78); color: rgb(239, 247, 255); }
.lesson-hud .unity-base-field { margin: 3px 0; }
.lesson-hud .unity-base-slider__tracker { background-color: rgb(74, 101, 126); }
.lesson-hud .unity-base-slider__dragger { background-color: rgb(141, 218, 231); }
.lesson-hud Button.term { min-height: 0; padding: 4px 7px; margin: 2px 0; }
.term Label { padding: 0; margin: 1px 0; min-height: 0; }
.lesson-progress { padding: 7px; margin-bottom: 8px; border-left-width: 3px; border-left-color: rgb(141, 218, 231); background-color: rgb(26, 37, 51); }
.lesson-objective { font-size: 12px; color: rgb(141, 218, 231); white-space: normal; margin: 4px 0; }
.lesson-answer { white-space: normal; -unity-text-align: middle-left; min-height: 28px; margin: 2px 0; padding: 4px; }

/* F10 display trees: mathematical structure is independent of metric binding. */
.math-layout { margin-top: 6px; margin-bottom: 10px; min-height: 48px; flex-shrink: 0; }
.math-layout Label { color: rgb(231, 239, 248); font-size: 17px; -unity-text-align: middle-center; white-space: nowrap; flex-shrink: 0; }
.math-row { flex-direction: row; align-items: center; flex-shrink: 0; }
.math-fraction { align-items: center; flex-shrink: 0; margin-left: 3px; margin-right: 3px; }
.math-numerator { border-bottom-width: 1px; border-bottom-color: rgb(215, 229, 245); padding-bottom: 3px; align-items: center; }
.math-scripts { margin-left: 1px; justify-content: center; }
.math-scripts Label, .math-limits Label { font-size: 12px; }
.math-limits { align-items: center; margin-left: 3px; margin-right: 3px; }
.math-limits .math-operator { font-size: 34px; }
.math-term { font-size: 17px; color: rgb(180, 221, 255); background-color: rgba(30, 60, 85, 0.6); border-width: 0; margin: 1px; padding: 3px; flex-shrink: 0; }
.math-term.selected { color: rgb(255, 228, 110); background-color: rgb(70, 67, 40); }
.math-matrix { border-left-width: 1px; border-right-width: 1px; border-left-color: rgb(215, 229, 245); border-right-color: rgb(215, 229, 245); padding: 3px; }
.math-cell { min-width: 38px; align-items: center; margin: 2px; }
#snapshot-parameters { margin-top: 8px; margin-bottom: 8px; }
