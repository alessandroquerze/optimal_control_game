<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="LessonHud.uss" />
    <ui:VisualElement name="lesson-hud" class="lesson-hud">
        <ui:VisualElement name="lesson-progress" class="lesson-progress">
            <ui:Label name="lesson-step-title" class="term-name" />
            <ui:Label name="lesson-step-objective" class="lesson-objective" />
            <ui:Label name="lesson-instruction" class="hud-note" />
            <ui:Label name="lesson-formula-expression" class="formula-expression" />
            <ui:VisualElement name="linearization-controls" />
            <ui:Foldout name="lesson-help-panel" text="Suggerimento" value="false"><ui:Label name="lesson-help" class="hud-note" /></ui:Foldout>
            <ui:Label name="lesson-question" class="hud-note" />
            <ui:VisualElement name="lesson-answers" />
            <ui:Label name="lesson-feedback" class="hud-note" />
            <ui:Label name="lesson-checks" class="hud-note" />
            <ui:VisualElement class="transport"><ui:Button name="lesson-previous" text="← Indietro" /><ui:Button name="lesson-next" text="Avanti →" /></ui:VisualElement>
            <ui:VisualElement class="transport"><ui:Button name="lesson-restart" text="Ricomincia" /><ui:Button name="lesson-explore" text="Esplorazione libera" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="timeline-status" class="hud-note" />
        <ui:VisualElement class="transport">
            <ui:Button name="step-back" text="← Step" />
            <ui:Button name="play-pause" text="Play" />
            <ui:Button name="step-next" text="Step →" />
            <ui:Button name="reset" text="Reset" />
        </ui:VisualElement>
        <ui:SliderInt name="timeline-seek" label="t" low-value="0" high-value="100" show-input-field="true" />
        <ui:Foldout text="Input e parametri" value="false" name="parameter-panel">
            <ui:DropdownField name="input-scope" label="Modifica" />
            <ui:VisualElement name="input-fields" />
            <ui:Label name="input-unavailable" text="N/A · al terminale non esiste u_T." class="hud-note" />
            <ui:VisualElement name="parameter-fields" />
            <ui:VisualElement name="initial-state-fields" />
            <ui:Label name="parameter-status" class="hud-note" />
            <ui:DoubleField name="playback-rate" label="Playback [campioni/s]" value="10" is-delayed="true" />
            <ui:Label text="Il playback regola la presentazione: non modifica δ né il risultato matematico." class="hud-note" />
        </ui:Foldout>
        <ui:Foldout text="Costo discreto, limiti e confronto A/B" value="false" name="cost-panel">
            <ui:Label name="cost-semantics" text="Costo per campione [1], non integrale. Q, QT ≥ 0; R > 0. Pesi con unità inverse al quadrato." class="hud-note" />
            <ui:VisualElement name="discretization-controls">
                <ui:Label name="physical-grid-status" class="hud-note" />
                <ui:SliderInt name="discretization-choice" label="Griglia δ" low-value="0" high-value="2" />
                <ui:DoubleField name="physical-step" label="δ [s] · H fisso" is-delayed="true" />
            </ui:VisualElement>
            <ui:Label name="cost-visual-legend" class="hud-note" />
            <ui:Label name="cost-live" class="hud-note" />
            <ui:Foldout text="Pesi, riferimento, limiti e orizzonte" value="false" name="cost-configuration">
            <ui:IntegerField name="horizon" label="T [1…10000]" is-delayed="true" />
            <ui:Label name="horizon-policy" class="hud-note" />
            <ui:VisualElement name="cost-parameters" />
            </ui:Foldout>
            <ui:VisualElement name="comparison-controls" class="transport">
                <ui:Button name="comparison-save" text="Salva B come A" />
                <ui:Button name="comparison-clear" text="Rimuovi A" />
            </ui:VisualElement>
            <ui:Foldout text="Configurazioni A/B e rispettivi obiettivi" value="false" name="comparison-configuration">
                <ui:Label name="comparison-status" class="hud-note" />
            </ui:Foldout>
        </ui:Foldout>
        <ui:VisualElement name="snapshot-parameters" />
        <ui:Label text="MATEMATICA LIVE · seleziona un termine" class="eyebrow" />
        <ui:DropdownField name="formula-choice" />
        <ui:Label name="formula-expression" class="formula-expression" />
        <ui:VisualElement name="formula-terms" />
        <ui:VisualElement class="term-detail">
            <ui:Label name="term-detail-title" class="term-name" />
            <ui:Label name="term-detail-meaning" class="hud-note" />
            <ui:Label name="term-detail-value" class="term-value" />
            <ui:Label name="term-detail-status" class="hud-note" />
            <ui:Label name="term-detail-world" class="hud-note" />
        </ui:VisualElement>
        <ui:Foldout text="Ipotesi e convenzioni" value="false">
            <ui:Label name="formula-description" class="hud-note" />
            <ui:Label name="formula-assumptions" class="hud-note" />
            <ui:Label name="dynamic-legend" text="Sfera blu: stato corrente. Cubo/ghost arancio: campione successivo. Linee: guide fra campioni, non interpolazione fisica. Tasti 1/2/3: layer definiti dallo scenario; le etichette indicano componenti e unità." class="hud-note" />
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
